<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}}</title>
  </head>
  <body style="margin: 0; padding: 24px 12px; background: #f8fafc; font-family: Arial, Helvetica, sans-serif; color: #1f2937; line-height: 1.6;">
    <div style="max-width: 560px; margin: 0 auto; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden;">
      <div style="padding: 16px 24px; background: #4f46e5; color: #ffffff; font-size: 18px; font-weight: bold;">
        Bookswap
      </div>
      <div style="padding: 24px;">
        <h2 style="margin: 0 0 16px; color: #4f46e5; font-size: 20px;">{{title}}</h2>
        {{> @partial-block}}
      </div>
    </div>
    <p style="max-width: 560px; margin: 16px auto 0; text-align: center; font-size: 12px; color: #94a3b8;">
      You received this email because you have an account on Bookswap.
    </p>
  </body>
</html>
