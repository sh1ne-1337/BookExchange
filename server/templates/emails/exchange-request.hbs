{{#> layout title="New exchange request"}}
  <p>Hi {{owner.name}},</p>
  <p>
    <strong>{{requester.name}}</strong>
    (<a href="mailto:{{requester.email}}" style="color: #4f46e5;">{{requester.email}}</a>)
    would like to exchange books with you for
    <strong>"{{requestedBook.name}}"</strong> by {{requestedBook.author}}.
  </p>
  <p style="margin-bottom: 8px;">Books they can offer:</p>
  <ul style="margin-top: 0; padding-left: 20px;">
    {{#each offeredBooks}}
      <li><strong>{{name}}</strong> by {{author}}</li>
    {{/each}}
  </ul>
  <p>Reply to this email to contact {{requester.name}} directly.</p>
  <p style="margin: 24px 0 0;">
    <a href="{{requestedBookUrl}}"
       style="display: inline-block; background: #4f46e5; color: #ffffff; padding: 10px 18px; border-radius: 8px; text-decoration: none;">
      View your book
    </a>
  </p>
{{/layout}}
