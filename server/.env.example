NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
# Set when running behind a reverse proxy / load balancer, so rate limits see real client IPs:
# number of proxies in front of the app (e.g. 1), or true, or a list such as "loopback, 10.0.0.0/8"
TRUST_PROXY=

DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=book_exchange

# Use a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_EXPIRES_IN=7d

# --- Email -------------------------------------------------------------------
# Local development: Mailpit from docker-compose (inbox UI: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Book Exchange <no-reply@bookexchange.local>"

# Real email via Gmail (requires 2-Step Verification and an App Password:
# https://myaccount.google.com/apppasswords). Gmail sends from your own address.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-character-app-password
# MAIL_FROM="Bookswap <you@gmail.com>"

# --- Image storage (AWS S3) -------------------------------------------------------
# Images are stored in a private bucket under S3_KEY_PREFIX and served through the API.
# Without access keys the AWS default credentials (e.g. ~/.aws/credentials) are used.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KEY_PREFIX=bookswap/uploads/

# Optional: demo users get real inboxes via plus addressing (you+olena@gmail.com).
# Applied when seeding, e.g. `npm run db:reset`.
DEMO_EMAIL=
